name:
  type: string
  description: Name (non-unique) of the host

uri:
  type: uri
  unique: true
  id: true
  description: |
    Unique address of the host. Could be IP or
    any other fully resolved name on the network

labels:
  type: string
  arity: 1..*
  description: |
    Labels that describe this host's roles and capabilities.

    Reserved labels — understood by the framework and used to
    configure the underlying k0s installation:

      controller  Runs the Kubernetes control plane (k0s controller)
      worker      Runs workloads / Pods (k0s worker)
      sole        Runs both the control plane and workloads on a
                  single node (k0s controller --single)

    Every host must carry at least one reserved label so that the
    framework knows how to install k0s on it.  Additional,
    user-defined labels can be combined freely for fine-grained
    feature targeting.

    Examples:
      labels: [controller]
      labels: [worker, compute, gpu]
      labels: [sole, dev]

ssh:
  type: custom
  arity: 1
  description: SSH connection parameters for this host
  schema:
    user:
      type: string
      default: root
      description: SSH username
    port:
      type: integer
      default: 22
      description: SSH port
    key:
      type: filesystem
      description: Path to the SSH private key file
    password:
      type: string
      description: SSH password (prefer key-based auth)
    known_hosts_file:
      type: filesystem
      description: |
        Path to a known_hosts file used to verify the host's SSH key.
        Defaults to ~/.ssh/known_hosts. Set to empty string to use only
        the system-level known_hosts without loading the user file.

ports:
  type: custom
  arity: 0..*
  description: Host's port configuration
  schema:
    role:
      type: string
    number:
      type: integer
    direction:
      type: string
      choice: ["in", "out", "both"]
    type:
      type: string
      choice: ["tcp", "udp"]

storage:
  type: custom
  arity: 0..*
  description: Storage locations on the host
  schema:
    role:
      type: string
    location:
      type: uri
    permissions:
      type: string
      choice: ["r", "rm", "w", "wm", "rw", "rwm"]

limits:
  type: custom
  arity: 0..*
  description: Resource limits on the host
  schema:
    role:
      type: string
      choice: ["cpu", "gpu", "ram", "vram"]
    percent:
      type: float
      description: Percentage between 0 and 1


    