name:
  type: string
  description: Name (non-unique) of the host

uri:
  type: uri
  unique: true
  id: true
  description: |
    Unique address of the host. Could be IP or
    any other fully resolved name on the network

labels:
  type: string
  arity: 1..*
  description: |
    Labels that describe this host's capabilities and targeting identity.
    At least one label is required.

    The framework understands two reserved labels that control how k0s is
    installed on the node:

      controller  Runs the Kubernetes control plane (k0s controller).
                  At least one host in the cluster MUST carry this label.
      sole        Runs both the control plane and workloads on a single node
                  (k0s controller --single).  Can also be triggered
                  automatically — see `no-sole` below.

    All other labels are user-defined and used exclusively for feature
    targeting.  There is no requirement to use the `worker` label; any host
    that does not carry `controller` or `sole` is automatically treated as a
    k0s worker node.

    Examples:
      labels: [controller]
      labels: [controller, primary, monitoring]
      labels: [compute, gpu]          # implicitly a k0s worker
      labels: [storage, high-io]      # implicitly a k0s worker

ssh:
  type: custom
  arity: 1
  description: SSH connection parameters for this host
  schema:
    user:
      type: string
      default: root
      description: SSH username
    port:
      type: integer
      default: 22
      description: SSH port
    key:
      type: filesystem
      description: Path to the SSH private key file
    password:
      type: string
      description: SSH password (prefer key-based auth)
    known_hosts_file:
      type: filesystem
      description: |
        Path to a known_hosts file used to verify the host's SSH key.
        Defaults to ~/.ssh/known_hosts. Set to empty string to use only
        the system-level known_hosts without loading the user file.

no-sole:
  type: boolean
  default: false
  description: |
    When true, prevents this controller from being promoted to sole mode,
    even when the cluster topology would normally trigger auto-sole (i.e.
    no non-controller hosts exist).  The node runs as a pure k0s controller
    without the --single flag and does NOT absorb unmatched feature labels.

    Has no effect on non-controller hosts.

ports:
  type: custom
  arity: 0..*
  description: Host's port configuration
  schema:
    role:
      type: string
    number:
      type: integer
    direction:
      type: string
      choice: ["in", "out", "both"]
    type:
      type: string
      choice: ["tcp", "udp"]

storage:
  type: custom
  arity: 0..*
  description: Storage locations on the host
  schema:
    role:
      type: string
    location:
      type: uri
    permissions:
      type: string
      choice: ["r", "rm", "w", "wm", "rw", "rwm"]

limits:
  type: custom
  arity: 0..*
  description: Resource limits on the host
  schema:
    role:
      type: string
      choice: ["cpu", "gpu", "ram", "vram"]
    percent:
      type: float
      description: Percentage between 0 and 1

backend:
  type: custom
  arity: 0..1
  description: |
    Backend-specific deployment configuration for this host.

    ``type`` selects which cluster-backend technology the host runs.
    All hosts in a cluster must declare the same ``type`` unless a
    translation recipe is provided for every distinct (source, target) pair
    — see the ``translations`` key at the cluster level.

    ``arguments`` holds arbitrary key→value pairs forwarded to the backend
    as CLI flags or configuration options.

    Every other key is treated as a *configuration file* entry: the key is
    the destination filename and the value is either the raw file content
    (expressed as a YAML block scalar) or a filesystem path pointing to an
    existing file.

    Because backend configuration is host-scoped, different hosts within the
    same backend type may carry different ``arguments`` and config files (e.g.
    a GPU node with a custom ``containerd.toml``).

    Note: k0s and Docker Swarm use incompatible control planes, join
    protocols, and overlay networks. They cannot form a single native cluster
    without a federation layer. See ``translations`` in the cluster schema.

    Example::

        backend:
          type: k0s          # explicit; same as the default
          arguments:
            --network: calico
          "k0s.yaml": |
            apiVersion: k0s.k0sproject.io/v1beta1
            kind: ClusterConfig
          "containerd.toml": "/etc/containerd/config.toml"

    Each backend fetches only the entries it recognises and ignores the rest.
  schema:
    type:
      type: string
      choice: ["k0s", "swarm"]
      default: k0s
      description: |
        Which cluster-backend technology this host runs.

        All hosts in a cluster must use the same ``type`` unless a
        translation recipe is provided for every (source, target) pair
        declared across the cluster's host definitions.

        ``k0s``   — lightweight Kubernetes distribution (default).
        ``swarm`` — Docker Swarm built-in orchestration.
    arguments:
      type: map
      arity: 0..1
      description: |
        Arbitrary key→value pairs forwarded to the backend as CLI flags.

    