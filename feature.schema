name:
  type: string
  unique: true
  id: true

labels:
  type: string
  arity: 1..*
  description: |
    Label(s) used to select the host(s) onto which to
    install this feature.

    A host is targeted when it carries at least one of
    these labels. Reserved labels (`controller`, `worker`,
    `sole`) may be used here to target all nodes of a
    given k0s role, or mixed freely with user-defined labels.

locations:
  type: uri
  arity: 0..*
  description: |
    Filepaths containing necessary installation
    scripts and configurations for deployment

install-cmds:
  type: bash
  arity: 0..*
  description: |
    List of installation commands. Runs
    sequentially. All filepaths defined under
    `locations` are mounted in the execution
    directory throughout deployment only

init-cmds:
  type: bash
  arity: 0..*
  description: |
    List of initialization commands, executed
    once, needed to execute the feature at
    runtime


  