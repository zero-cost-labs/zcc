name:
  type: string
  unique: true
  id: true

labels:
  type: string
  arity: 0..*
  description: |
    Label(s) used to select host(s) onto which to
    install this feature. A host matches when it
    carries at least one of these labels.

roles:
  type: string
  arity: 0..*
  choice: ["controller", "worker", "sole"]
  description: |
    Role(s) used to select host(s) onto which to
    install this feature. A host matches when it
    has at least one of these roles.
    Either `labels` or `roles` (or both) must be
    provided for the feature to be deployed anywhere.

locations:
  type: uri
  arity: 0..*
  description: |
    Filepaths containing necessary installation
    scripts and configurations for deployment

install-cmds:
  type: bash
  arity: 0..*
  description: |
    List of installation commands. Runs
    sequentially. All filepaths defined under
    `locations` are mounted in the execution
    directory throughout deployment only

init-cmds:
  type: bash
  arity: 0..*
  description: |
    List of initialization commands, executed
    once, needed to execute the feature at
    runtime

  